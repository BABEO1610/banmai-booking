NODE_ENV=development
PORT=3000
# mock is the safe local demo default. Set postgres only after a dedicated DB is ready.
DATA_MODE=mock
DATABASE_URL=postgres://user:password@host:5432/database
MIGRATION_DATABASE_URL=postgres://user:password@host:5432/database
TEST_DATABASE_URL=postgres://test:test@localhost:5433/studio_booking_test
DATABASE_SSL_CA_PATH=./certs/supabase-ca.pem
# Keep the pool small for Supabase; override only when the database plan supports it.
PG_POOL_MAX=4
PG_CONNECTION_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=15000
PG_STATEMENT_TIMEOUT_MS=15000
PG_IDLE_TIMEOUT_MS=60000
SESSION_SECRET=replace-with-at-least-32-random-characters
EMAIL_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
DEMO_MAIL_TOKEN=local-demo-only
PUBLIC_ORIGIN=http://localhost:5173
IMAGE_STORAGE=local
# For public images in production: IMAGE_STORAGE=supabase, then fill these server-only values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=studio-media
STUDIO_TIMEZONE=Asia/Ho_Chi_Minh
MAX_CONCURRENT_BOOKINGS=2
BUFFER_BEFORE_MINUTES=0
BUFFER_AFTER_MINUTES=0
PAYMENT_MODE=mock
SMS_MODE=mock
SHEETS_MODE=mock
SHEETS_SPREADSHEET_ID=
SHEETS_TAB=Bookings
GOOGLE_APPLICATION_CREDENTIALS=
SHEETS_SYNC_INTERVAL_MS=5000
WORKER_MODE=in-process

# Local email OTP. SMTP_PASSWORD is a Gmail App Password, not your Gmail password.
# mail:check uses these settings; the app OTP adapter still needs implementation.
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password-without-spaces
MAIL_FROM="Ban Mai Studio <your-sender@gmail.com>"
BOOTSTRAP_ADMIN_EMAIL=your-admin@example.com
