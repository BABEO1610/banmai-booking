{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://banmai-booking-aez2.vercel.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://banmai-booking-aez2.vercel.app/media/:path*"
    },
    {
      "source": "/((?!api|media|assets|images|fonts).*)",
      "destination": "/index.html"
    }
  ]
}
