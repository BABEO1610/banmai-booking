{
  "name": "react-express-starter",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test:e2e": "playwright test"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.1"
  }
}
